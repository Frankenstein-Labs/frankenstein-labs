# Copy to .env and fill in real values. Never commit a real .env file.

# --- API (services/api) ---
PORT=3000
# Absolute path (or path relative to the server file) of the generated catalog
# index. In the container it is copied to /catalog/index.json.
CATALOG_INDEX=/app/catalog/index.json
# Shared secret required on every /api/* request via the
# x-frankenstein-api-secret header. Generate with: openssl rand -hex 32
FRANKENSTEIN_API_SECRET=
# Local development only: set to 1 to disable the API secret check.
# Never enable this in production.
ALLOW_INSECURE_NO_AUTH=0
# Proxy hardening.
CODER_TIMEOUT_MS=30000
MAX_PROXY_BODY_BYTES=1048576

# --- Coder (official control plane) ---
CODER_ACCESS_URL=https://coder.example.com
# Internal "host:port" of the Coder service (no scheme is also accepted).
CODER_INTERNAL_URL=http://frankenstein-coder:7080
CODER_PG_CONNECTION_URL=postgresql://user:password@host:5432/coder?sslmode=require
CODER_SESSION_TOKEN=
CODER_HTTP_ADDRESS=0.0.0.0:7080
CODER_TELEMETRY_ENABLE=false
CODER_ORGANIZATION=
COOKIE_SECURE=true
LOG_LEVEL=info

# --- Catalog worker (services/worker) ---
# Seconds between catalog synchronization runs. Set to 0 (or set
# WORKER_RUN_ONCE=1) to run a single pass and exit.
WORKER_INTERVAL_SECONDS=3600
WORKER_RUN_ONCE=0
# Skip cloning vendor/coder and vendor/registry (useful when submodules exist).
SKIP_SOURCE_CLONE=0

# --- External workspace compute (required for real workspaces) ---
# Render private services cannot run privileged Docker-in-Docker. Point Coder
# at an external compute backend instead.
CODER_PROVISIONER=external
CODER_PROVISIONER_URL=
DOCKER_HOST=
KUBERNETES_HOST=
KUBERNETES_TOKEN=

# --- Optional integrations ---
DATABASE_URL=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CORTEX_API_URL=

# --- Cloud provider credentials used by workspace templates (never commit) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
